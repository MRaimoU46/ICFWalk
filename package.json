{
  "name": "icfwalk",
  "version": "0.1.0",
  "private": true,
  "description": "ICFWalk instructional walkthrough application (Adobe ColdFusion 2023 + SQL Server). Node is used only for handoff validation, reference snapshot tooling, and the test harness.",
  "type": "module",
  "scripts": {
    "validate:handoff": "node scripts/validate-handoff.mjs",
    "snapshot:compile": "node scripts/compile-snapshot.mjs",
    "test": "node --test --test-concurrency=1 \"tests/node/*.test.mjs\"",
    "test:package": "node --test tests/node/package.test.mjs tests/node/canonical-json.test.mjs tests/node/snapshot.test.mjs tests/node/schema-contract.test.mjs",
    "test:db": "node --test tests/node/db-scripts.test.mjs",
    "test:cfml": "node --test tests/node/cfml-suite.test.mjs",
    "test:auth": "node --test tests/node/auth.test.mjs",
    "test:shell": "node --test tests/node/shell.test.mjs tests/node/visibility.test.mjs",
    "test:browser": "node --test tests/node/browser.test.mjs",
    "db:apply": "node scripts/db/apply-schema.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "mssql": "^12.7.2",
    "playwright": "^1.56.1"
  }
}
