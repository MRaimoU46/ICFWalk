# ICFWalk environment template. Copy to .env for local development (never commit .env).
# Real environment variables always override values in this file.

# development | test | staging | production   (default: production, which fails closed)
ICFWALK_ENVIRONMENT=development

# --- Database ---------------------------------------------------------------------------------
# Option A (production): a datasource created in the ColdFusion Administrator with this name.
ICFWALK_DATASOURCE=icfwalk
# Option B (development/test/containers): define the datasource from the environment. When
# ICFWALK_DB_HOST is set, Application.cfc registers the datasource named above from these values.
ICFWALK_DB_HOST=127.0.0.1
ICFWALK_DB_PORT=1433
ICFWALK_DB_NAME=icfwalk_dev
ICFWALK_DB_USER=
ICFWALK_DB_PASSWORD=
ICFWALK_DB_ENCRYPT=true
# Only for local containers with self-signed certificates. Keep false in production.
ICFWALK_DB_TRUST_SERVER_CERT=false

# --- Logging ------------------------------------------------------------------------------------
ICFWALK_LOG_LEVEL=INFO
ICFWALK_LOG_NAME=icfwalk

# --- Instrument identity and walk consistency ---------------------------------------------------
# The instrument every walk is conducted against. Runtime version selection, draft import, and
# draft discard are all scoped to it, so a second instrument sharing a version label can never be
# selected or deleted in its place.
ICFWALK_INSTRUMENT_CODE=ICFWALK
# The dimension code whose value identifies the school a walk was conducted at. A walk at a SCHOOL
# org unit must carry the matching value; the authorized org unit is authoritative.
ICFWALK_SCHOOL_DIMENSION_CODE=school

# --- Instrument configuration seed --------------------------------------------------------------
# Defaults to <repo>/config/instrument-config.json
# ICFWALK_INSTRUMENT_CONFIG_PATH=

# --- Maintenance endpoints (seed, version list, test runner) ------------------------------------
# Disabled unless explicitly enabled. Token must be at least 32 characters. Loopback-only unless
# ICFWALK_MAINTENANCE_ALLOW_REMOTE=true.
ICFWALK_MAINTENANCE_ENABLED=false
ICFWALK_MAINTENANCE_TOKEN=
ICFWALK_MAINTENANCE_ALLOW_REMOTE=false

# CFML test runner route (/api/maintenance/tests/run). Never enabled in production.
ICFWALK_TESTS_ENABLED=false

# --- Identity (Phase 2) -------------------------------------------------------------------------
# header      production: identity asserted by the district SSO gateway / reverse proxy in headers
# development development/test only: identity named in X-ICFWalk-Dev-Subject (requires the stub)
ICFWALK_SSO_MODE=header
ICFWALK_SSO_SUBJECT_HEADER=X-Auth-Subject
ICFWALK_SSO_NAME_HEADER=X-Auth-Name
ICFWALK_SSO_EMAIL_HEADER=X-Auth-Email
# Only these source addresses (IPv4 or CIDR, comma separated) may assert identity. Required in
# production; nobody is trusted when empty.
ICFWALK_SSO_TRUSTED_PROXIES=
# Optional: the gateway must also send this value in ICFWALK_SSO_SECRET_HEADER (32+ chars).
ICFWALK_SSO_SECRET_HEADER=X-Auth-Proxy-Secret
ICFWALK_SSO_SHARED_SECRET=
# Create app_user rows on first sign-in (users still have no access until a role is assigned).
ICFWALK_AUTO_PROVISION_USERS=true
# Development identity stub. The application refuses to start when this is true in production.
ICFWALK_DEV_IDENTITY_ENABLED=false

# --- Sessions -----------------------------------------------------------------------------------
ICFWALK_SESSION_TIMEOUT_MINUTES=60
# Secure cookie flag. Cannot be false in production.
ICFWALK_COOKIE_SECURE=true

# --- Open-decision policy seams (docs/OPEN_DECISIONS.md) ----------------------------------------
# Whether unresolved placeholder prompts block instrument publication (default: warn only).
ICFWALK_PLACEHOLDER_WARNINGS_BLOCK_PUBLISH=false
# RETAIN_HIDDEN (default) or CLEAR: what happens to a Period value when the grade leaves 6-12.
ICFWALK_HIDDEN_PERIOD_POLICY=RETAIN_HIDDEN
# Aggregate privacy-suppression threshold (docs/OPEN_DECISIONS.md: not decided). Empty or 0 applies
# none. A whole number N withholds any report population of fewer than N walks, and any org-unit or
# dimension-value group of fewer than N walks within one. Anything that is not a whole number
# refuses startup rather than silently applying no suppression.
ICFWALK_REPORT_SUPPRESSION_THRESHOLD=

# --- Instrument rendering (Phase 3) -------------------------------------------------------------
# Walks render the newest PUBLISHED instrument version. Until Phase 6 publishes one, development
# and test deployments may render the newest DRAFT snapshot (marked isFallbackDraft in the API).
# Defaults to true outside production; cannot be true in production.
ICFWALK_ALLOW_UNPUBLISHED_INSTRUMENT=true

# --- Local runtime helpers (tools/runtime) ------------------------------------------------------
ICFWALK_PORT=8888
