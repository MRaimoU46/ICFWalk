<?xml version="1.0" encoding="UTF-8"?>
<!-- Servlet descriptor used only by tools/runtime/lucee-up.sh (local Lucee verification runtime).
     Adobe ColdFusion 2023 deployments use the connector configured by the ColdFusion installer. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <servlet>
    <servlet-name>CFMLServlet</servlet-name>
    <servlet-class>lucee.loader.servlet.CFMLServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping><servlet-name>CFMLServlet</servlet-name><url-pattern>*.cfm</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>CFMLServlet</servlet-name><url-pattern>*.cfc</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>CFMLServlet</servlet-name><url-pattern>/index.cfm/*</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>index.cfm</welcome-file></welcome-file-list>
  <!-- The servlet session that Lucee's sessionRotate() opens beside its own (the application's session
       is keyed by Lucee's cfid cookie and holds everything): its JSESSIONID cookie is HttpOnly and
       SameSite=Lax like the rest (Jetty reads the SameSite marker in the comment), and, with no
       max-age, lasts only as long as the browser session (P8-05). -->
  <session-config>
    <cookie-config>
      <comment>__SAME_SITE_LAX__</comment>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>
</web-app>
